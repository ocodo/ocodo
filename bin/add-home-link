#!/usr/bin/env zsh

homepage_folder=$HOME/workspace/ocodo

git -C "$homepage_folder" pull --rebase --autostash

echo "Add link to ocodo homepage"
vared -p "Link: " -c link
vared -p "Title: " -c title

markdown="- [${title}](${link})"

add=$(echo "y\nn" | fzf \
    --reverse \
    --header "Add to the homepage? | $markdown" \
    --no-sort --height 6)

if [[ "$add" == "y" ]]; then
    cd $homepage_folder

    insert_at=$(cat -n pages/index.md \
                   | fzf --no-sort --reverse --height 20 \
                         --header "Select a line to insert the link (below)" \
                   | cut -f 1 \
                   | tr -d ' ')

    should_indent=$(echo "y\nn" | fzf \
       --reverse \
       --header "Indent this link: $markdown" \
       --no-sort --height 6)

    if [[ "$should_indent" == "y" ]]; then
        markdown="    $markdown"
    fi

    ed -s pages/index.md <<< "$insert_at"$'a\n'"$markdown"$'\n.\nwq'

    bin/build
    git --no-pager diff

    all_ok=$(echo "n\ny" | fzf \
       --reverse \
       --header "All ok? If (y) we'll commit and push to GitHub" \
       --no-sort --height 6)

    [ "$all_ok" != "y" ] && exit

    git add .
    git commit -s -m "added ${title}"
    git pull --rebase
    git push
fi
